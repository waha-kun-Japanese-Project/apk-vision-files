# ============================================
# Service Settings
# ============================================
SERVICE_NAME=vision-service
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8001
DEBUG=true

# ============================================
# Model Settings
# ============================================
MODEL_PATH=./models/efficientnet_waha_kun.keras
CONFIDENCE_THRESHOLD=50.0

# ============================================
# File Settings
# ============================================
UPLOAD_FOLDER=./uploads
MAX_FILE_SIZE=10485760

# ============================================
# Image Processing
# ============================================
QUALITY_CHECK_ENABLED=true
ENHANCE_IMAGE_ENABLED=true

# ============================================
# RabbitMQ Settings
# ============================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest